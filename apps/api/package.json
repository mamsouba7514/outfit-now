{
  "name": "@outfit-now/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "minio": "mkdir -p /tmp/minio-data && MINIO_ROOT_USER=minioadmin MINIO_ROOT_PASSWORD=minioadmin minio server /tmp/minio-data --address :9000 --console-address :9001",
    "minio:init": "mc alias set local http://localhost:9000 minioadmin minioadmin --api S3v4 && mc mb local/outfit-now --ignore-existing && mc anonymous set download local/outfit-now",
    "dev:worker": "tsx --env-file=.env watch src/workers/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fal-ai/client": "^1.10.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@outfit-now/shared-types": "*",
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.1",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "stripe": "^15.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^1.6.0",
    "prisma": "^5.15.0",
    "tsx": "^4.16.2",
    "typescript": "*",
    "vitest": "^1.6.0"
  }
}
