{
  "expo": {
    "name": "Outfit Now",
    "slug": "outfit-now",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "outfitnow",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.outfitnow.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Outfit Now uses your location to get the current weather and suggest appropriate outfits.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "app.outfitnow.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Outfit Now uses the camera to scan your clothes." }],
      [
        "expo-image-picker",
        { "photosPermission": "Outfit Now accesses your photos to add clothes to your dressing." }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Outfit Now uses your location to get the current weather and suggest appropriate outfits."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
